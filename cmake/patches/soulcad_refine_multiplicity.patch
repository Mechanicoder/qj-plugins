diff --git a/kernels/smlib/intersect_face_face.cpp b/kernels/smlib/intersect_face_face.cpp
index dc92eb8..5c2d836 100644
--- a/kernels/smlib/intersect_face_face.cpp
+++ b/kernels/smlib/intersect_face_face.cpp
@@ -438,6 +438,17 @@ void RefineOnKnots(Geom_BSplineCurve& curve, const Geom_BSplineCurve& source)
     NCollection_Array1<int> multiplicities(1, source.NbKnots());
     source.Knots(knots);
     source.Multiplicities(multiplicities);
+    // InsertKnots 要求插入后的重数不超过目标曲线的允许上限（内部 <= degree，
+    // 端点 <= degree+1）。源曲线次数更高时端点重数会超出；继续插入会让
+    // OCC 在内部越界写并破坏堆，因此放弃本次细化。
+    for (int i = 1; i <= source.NbKnots(); ++i)
+    {
+        const int limit = (i == 1 || i == source.NbKnots()) ? curve.Degree() + 1 : curve.Degree();
+        if (multiplicities(i) > limit)
+        {
+            return;
+        }
+    }
     curve.InsertKnots(knots, multiplicities, 0, false);
 }
 
